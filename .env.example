# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL (used by both the db container and the app) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ai_business_os
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional: full SQLAlchemy URL, overrides POSTGRES_* above.
# DATABASE_URL=

# --- amoCRM (long-lived token) ---
# Account domain without scheme, e.g. yourcompany.amocrm.ru
AMO_DOMAIN=
AMO_TOKEN=

# --- hh.ru (employer OAuth) ---
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_REFRESH_TOKEN=
# Required by hh.ru: "AppName/1.0 (contact-email)"
HH_USER_AGENT=
# Optional: if empty, taken from GET /me (see README, TODO)
HH_EMPLOYER_ID=
# true -> active vacancies of all managers you have access to
HH_VACANCIES_ALL_ACCESSIBLE=false
# true -> on token-expired, refresh via POST https://api.hh.ru/token (the ONLY non-GET call; off by default)
HH_TOKEN_AUTO_REFRESH=false

# --- HTTP behaviour (shared by both clients) ---
HTTP_RPS=5
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE=1.0
HTTP_BACKOFF_MAX=60
HTTP_TIMEOUT=30

# --- Sync ---
# Incremental sync re-reads this many seconds before the saved cursor
SYNC_OVERLAP_SECONDS=300
